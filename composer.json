{
  "name": "sevada/nie-validator",
  "description": "Laravel validation rule for Spanish NIE (Número de Identidad de Extranjero) numbers",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "validation",
    "nie",
    "spanish",
    "identity",
    "validator",
    "spain"
  ],
  "homepage": "https://github.com/sevada/nie-validator",
  "support": {
    "issues": "https://github.com/sevada/nie-validator/issues",
    "source": "https://github.com/sevada/nie-validator"
  },
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5|^11.0",
    "orchestra/testbench": "^8.0|^9.0",
    "phpstan/phpstan": "^1.10",
    "laravel/pint": "^1.13"
  },
  "autoload": {
    "psr-4": {
      "Sevada\\NieValidator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sevada\\NieValidator\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Sevada\\NieValidator\\NieValidatorServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test:coverage": "vendor/bin/phpunit --coverage-html coverage",
    "analyze": "vendor/bin/phpstan analyse",
    "format": "vendor/bin/pint",
    "format:check": "vendor/bin/pint --test",
    "check": [
      "@test",
      "@analyze",
      "@format:check"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}