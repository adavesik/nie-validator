# ============================================
# NIE Validator Package - Production .gitignore
# ============================================

# Composer Dependencies
/vendor/

# Environment Files (CRITICAL - Never commit!)
.env
.env.*
!.env.example

# PHPUnit Cache & Test Results
/.phpunit.result.cache
.phpunit.result.cache
/.phpunit.cache
/phpunit.xml
phpunit.xml

# Code Coverage Reports
/coverage/
/build/
*.coveragerc
/.coverage
/clover.xml
/coverage.xml

# PHPStan Cache & Baseline
/.phpstan.cache
/phpstan-baseline.neon

# Laravel Pint Cache
/.php-cs-fixer.cache

# IDE & Editor Files
/.idea/
/.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.settings/
.buildpath

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node Modules (if using npm/yarn)
/node_modules/

# Temporary Files
/tmp/
/temp/
*.tmp
*.bak
*.swp
*.cache

# Security & Sensitive Files (CRITICAL)
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
*.der
*_rsa
*_rsa.pub
*.ppk
/secrets/
/credentials/

# Database Files
*.sqlite
*.sqlite3
*.db

# Compiled Files
*.com
*.class
*.dll
*.exe
*.o
*.so

# Archives (usually shouldn't be in repo)
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Docker (Development Only - Keep for this project)
# Uncomment these if you don't want Docker files in production:
# /.docker/
# /Dockerfile
# /docker-compose.yml
# /docker-compose.*.yml

# Package Manager Lock Files
# Note: For libraries, composer.lock SHOULD be tracked
# For applications, it should be ignored
# We're keeping it tracked as this is a library

# Miscellaneous
.phpunit.cache